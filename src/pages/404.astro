---
/**
 * Página 404.
 */
import Layout from "../layouts/Layout.astro";
import sitio from "../datos/sitio.json";
---

<Layout titulo="Página no encontrada — CONAMIC" descripcion="La página que buscas no existe.">
  <section class="pad" style="min-height:70vh; display:flex; align-items:center;">
    <div class="container" style="text-align:center; max-width:680px;">
      <p class="marca-text" style="font-family:var(--font-display); font-weight:700; font-size:clamp(4rem,12vw,7rem); line-height:1;">404</p>
      <h1 style="font-family:var(--font-display); font-size:clamp(1.5rem,4vw,2.2rem); font-weight:600; margin-top:18px;">Esta página se perdió en el camino.</h1>
      <p class="lead" style="margin-top:16px;">Pero tu negocio no tiene por qué perderse. Vuelve al inicio o escríbenos directamente.</p>
      <div style="margin-top:34px; display:flex; gap:14px; justify-content:center; flex-wrap:wrap;">
        <a href="/" class="btn btn-primary">Volver al inicio</a>
        <a href={`https://wa.me/${sitio.whatsapp}`} target="_blank" rel="noopener" class="btn btn-ghost">Escríbenos al WhatsApp</a>
      </div>
    </div>
  </section>
</Layout>