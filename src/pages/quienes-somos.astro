---
/**
 * Página Quiénes Somos. Contenido desde src/datos/quienes-somos.json.
 */
import Layout from "../layouts/Layout.astro";
import sitio from "../datos/sitio.json";
import datos from "../datos/quienes-somos.json";
import { ruta } from "../lib/ruta";

const { meta, hero, misionVision, valores, historia, equipo, alianzas } = datos;
---

<Layout titulo={meta.titulo} descripcion={meta.descripcion} activa="quienes-somos">
  {/* ==================== HERO ==================== */}
  <header class="portada">
    <div class="container portada-grid">
      <div>
        <span class="eyebrow reveal"><span class="dot"></span> {hero.encabezado}</span>
        <h1 class="reveal">{hero.titulo}</h1>
        <p class="lead reveal" style="margin-bottom:14px;">{hero.texto1}</p>
        <p class="reveal" style="color:var(--text-muted);">{hero.texto2}</p>
      </div>
      <div class="portada-visual reveal" data-parallax="0.08">
        <img src={ruta(hero.imagen)} alt={hero.imagenAlt} loading="eager" width="900" height="650" />
      </div>
    </div>
  </header>

  {/* ==================== MISIÓN Y VISIÓN ==================== */}
  <section class="pad">
    <div class="container">
      <span class="eyebrow reveal-up"><span class="dot"></span> Nuestra razón de ser</span>
      <div class="nosotros-grid" style="margin-top:10px; align-items:start;">
        <div class="reveal-left">
          <h2 class="section-title" style="font-size:1.7rem;">{misionVision.misionTitulo}</h2>
          <p class="lead" style="margin-top:16px;">{misionVision.misionTexto}</p>
        </div>
        <div class="reveal-right">
          <h2 class="section-title" style="font-size:1.7rem;">{misionVision.visionTitulo}</h2>
          <p class="lead" style="margin-top:16px;">{misionVision.visionTexto}</p>
        </div>
      </div>
    </div>
  </section>

  {/* ==================== VALORES ==================== */}
  <section class="pad" style="background:var(--bg-soft)">
    <div class="container">
      <h2 class="section-title reveal">{valores.titulo}</h2>
      <div class="grid-servicios" data-stagger>
        {valores.items.map((v) => (
          <article class="card reveal-up">
            <i data-lucide={v.icono}></i>
            <h3>{v.nombre}</h3>
            <p>{v.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ==================== HISTORIA — franja azul institucional ==================== */}
  <section class="pad franja-azul">
    <div class="container">
      <h2 class="section-title reveal">{historia.titulo}</h2>
      {historia.parrafos.map((p) => (
        <p class="lead reveal" style="margin-top:18px; max-width:820px;">{p}</p>
      ))}

      <div class="timeline">
        {historia.hitos.map((h, i) => (
          <div class={`timeline-item reveal-up ${i % 2 ? "der" : ""}`}>
            <span class="tl-punto"></span>
            <div class="tl-tarjeta">
              <span class="tl-anio">{h.anio}</span>
              <p>{h.texto}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ==================== EQUIPO DIRECTIVO ==================== */}
  <section class="pad">
    <div class="container">
      <h2 class="section-title reveal">{equipo.titulo}</h2>
      <p class="lead reveal">{equipo.texto}</p>

      <div class="slider-envoltura reveal-up">
        <button class="slider-flecha" id="eqPrev" type="button" aria-label="Directivo anterior"><i data-lucide="chevron-left"></i></button>
        <div class="slider-pista" id="eqPista">
          {equipo.miembros.map((m) => (
            <article class="directivo-card">
              <img
                class="directivo-foto"
                src={ruta(m.foto)}
                alt={`Foto de ${m.nombre}`}
                loading="eager"
                width="112" height="112"
              />
              <h3 style="font-size:1.02rem; margin-bottom:6px;">{m.nombre}</h3>
              <p style="color:var(--crecimiento); font-weight:600; font-size:.88rem; margin:0;">{m.cargo}</p>
            </article>
          ))}
        </div>
        <button class="slider-flecha" id="eqNext" type="button" aria-label="Directivo siguiente"><i data-lucide="chevron-right"></i></button>
      </div>
      <div class="slider-puntos" id="eqPuntos"></div>
      {equipo.notaFoto && <p style="text-align:center; color:var(--text-muted); font-size:.85rem; margin-top:14px;">{equipo.notaFoto}</p>}

      <script>
        const pista = document.getElementById("eqPista");
        const prev = document.getElementById("eqPrev");
        const next = document.getElementById("eqNext");
        const puntos = document.getElementById("eqPuntos");
        const tarjetas = [...pista.children];

        const paso = () => Math.max(pista.clientWidth * 0.7, 240);
        prev.addEventListener("click", () => pista.scrollBy({ left: -paso(), behavior: "smooth" }));
        next.addEventListener("click", () => pista.scrollBy({ left: paso(), behavior: "smooth" }));

        tarjetas.forEach((t, i) => {
          const b = document.createElement("button");
          b.type = "button";
          b.setAttribute("aria-label", `Ir al directivo ${i + 1}`);
          b.addEventListener("click", () => t.scrollIntoView({ behavior: "smooth", inline: "center", block: "nearest" }));
          puntos.append(b);
        });

        let raf = null;
        const actualizar = () => {
          raf = null;
          const pasoX = tarjetas.length > 1 ? tarjetas[1].offsetLeft - tarjetas[0].offsetLeft : 1;
          const i = Math.min(tarjetas.length - 1, Math.max(0, Math.round(pista.scrollLeft / pasoX)));
          puntos.querySelectorAll("button").forEach((b, j) => b.classList.toggle("activo", j === i));
          prev.disabled = pista.scrollLeft <= 4;
          next.disabled = pista.scrollLeft >= pista.scrollWidth - pista.clientWidth - 4;
        };
        pista.addEventListener("scroll", () => { if (!raf) raf = requestAnimationFrame(actualizar); }, { passive: true });
        window.addEventListener("resize", actualizar);
        actualizar();
      </script>
    </div>
  </section>

  {/* ==================== ALIANZAS ==================== */}
  <section class="pad" style="background:var(--bg-soft)">
    <div class="container">
      <h2 class="section-title reveal">{alianzas.titulo}</h2>
      <p class="lead reveal" style="max-width:820px;">{alianzas.texto}</p>

      <div class="grid-servicios" data-stagger>
        {alianzas.items.map((a) => (
          <article class="card reveal-up">
            <i data-lucide={a.icono}></i>
            <h3>{a.titulo}</h3>
            <p>{a.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ==================== CTA ==================== */}
  <section class="pad">
    <div class="container" style="text-align:center; max-width:720px;">
      <h2 class="section-title reveal">Una organización representa. Una red articulada transforma.</h2>
      <div class="reveal" style="margin-top:34px;">
        <a href={ruta("/afiliacion")} class="btn btn-primary">¡Quiero ser parte de CONAMIC!</a>
      </div>
    </div>
  </section>
</Layout>