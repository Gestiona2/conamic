---
/**
 * Página legal genérica: renderiza una política desde src/datos/legales.json.
 * Se usa para /politica-privacidad y /tratamiento-datos.
 */
import Layout from "../layouts/Layout.astro";
import legales from "../datos/legales.json";

export function getStaticPaths() {
  return [
    {
      params: { legal: "politica-privacidad" },
      props: { doc: legales.politicaPrivacidad, activa: null },
    },
    {
      params: { legal: "tratamiento-datos" },
      props: { doc: legales.tratamientoDatos, activa: null },
    },
  ];
}

const { doc, activa } = Astro.props;
---

<Layout titulo={doc.meta.titulo} descripcion={doc.meta.descripcion} activa={activa}>
  <section class="pad">
    <div class="container" style="max-width:820px;">
      <span class="eyebrow reveal"><span class="dot"></span> Legal</span>
      <h1 class="reveal" style="font-size:clamp(2rem,4vw,3rem); margin-top:14px;">{doc.titulo}</h1>
      <p class="lead reveal" style="margin-top:20px;">{doc.intro}</p>

      {doc.secciones.map((s) => (
        <div class="reveal-up" style="margin-top:44px;">
          <h2 style="font-family:var(--font-display); font-size:1.25rem; font-weight:600; color:var(--text);">{s.titulo}</h2>
          <p style="color:var(--text-muted); margin-top:10px; line-height:1.7;">{s.texto}</p>
        </div>
      ))}

      <p style="margin-top:56px; padding-top:24px; border-top:1px solid var(--border); font-size:.85rem; color:var(--text-muted);">
        {doc.actualizacion}
      </p>
    </div>
  </section>
</Layout>