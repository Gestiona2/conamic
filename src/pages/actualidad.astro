---
/**
 * Página Actualidad (blog). Contenido desde src/datos/actualidad.json.
 * Cada tarjeta enlaza a su página individual /actualidad/[slug].
 */
import Layout from "../layouts/Layout.astro";
import datos from "../datos/actualidad.json";
import { ruta } from "../lib/ruta";

const { meta, hero, categorias, articulos } = datos;
---

<Layout titulo={meta.titulo} descripcion={meta.descripcion} activa="noticias">
  {/* ==================== HERO ==================== */}
  <header class="portada" style="padding-bottom:80px;">
    <div class="container">
      <span class="eyebrow reveal"><span class="dot"></span> {hero.encabezado}</span>
      <h1 class="reveal" style="font-size:clamp(2.2rem,5vw,3.6rem); max-width:820px;">{hero.titulo}</h1>
      <p class="lead reveal" style="max-width:760px; margin-top:20px;">{hero.texto}</p>
    </div>
  </header>

  {/* ==================== FILTROS DE CATEGORÍA ==================== */}
  <section style="padding-top:36px;">
    <div class="container">
      <div class="reveal" style="display:flex; gap:12px; flex-wrap:wrap;">
        {categorias.map((c, i) => (
          <button
            type="button"
            data-filtro={c}
            class={`btn ${i === 0 ? "btn-primary" : "btn-ghost"} btn-filtro`}
          >{c}</button>
        ))}
      </div>
    </div>
  </section>

  {/* ==================== ARTÍCULOS ==================== */}
  <section class="pad" style="padding-top:40px;">
    <div class="container">
      <div class="grid-testimonios" id="listaArticulos" data-stagger>
        {articulos.map((a) => (
          <article class="card articulo-card reveal-up" data-categoria={a.categoria}>
            <!-- TODO: reemplazar placeholder con imagen real del artículo -->
            <img src={ruta(a.imagen)} alt={a.imagenAlt} loading="lazy" width="600" height="400" />
            <div class="articulo-cuerpo">
              <span class="articulo-etiqueta">{a.categoria} · {a.segmento}</span>
              <h3><a href={ruta(`/actualidad/${a.slug}`)}>{a.titulo}</a></h3>
              <p>{a.descripcion}</p>
              <p class="articulo-meta">{a.fecha} · {a.tiempoLectura} de lectura</p>
              <a class="articulo-leer" href={ruta(`/actualidad/${a.slug}`)}>Leer más <i data-lucide="arrow-right" style="width:15px;height:15px;"></i></a>
            </div>
          </article>
        ))}
      </div>

      <p id="sinResultados" hidden style="color:var(--text-muted); text-align:center; padding:40px 0;">
        No hay artículos publicados en esta categoría todavía.
      </p>

      <nav class="paginacion" id="paginador" aria-label="Paginación de artículos"></nav>
    </div>
  </section>

  {/* ==================== CTA ==================== */}
  <section class="pad franja-azul">
    <div class="container" style="text-align:center; max-width:760px;">
      <h2 class="section-title reveal">¿Quieres recibir estas guías antes que nadie?</h2>
      <p class="lead reveal" style="margin-top:16px;">Afíliate y recibe directamente en tu WhatsApp el conocimiento que tu negocio necesita.</p>
      <div class="reveal" style="margin-top:34px; display:flex; gap:14px; justify-content:center; flex-wrap:wrap;">
        <a href={ruta("/afiliacion")} class="btn btn-primary">Quiero afiliarme</a>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  /* Filtro por categoría + paginación (12 por página).
     El JSON llega ordenado por fechaISO descendente: lo más nuevo primero. */
  (function () {
    const botones = document.querySelectorAll(".btn-filtro");
    const tarjetas = [...document.querySelectorAll("#listaArticulos .articulo-card")];
    const sinResultados = document.getElementById("sinResultados");
    const paginador = document.getElementById("paginador");
    const POR_PAGINA = 12;
    let categoria = "Todas";
    let pagina = 1;

    const filtradas = () =>
      categoria === "Todas" ? tarjetas : tarjetas.filter((t) => t.dataset.categoria === categoria);

    const render = () => {
      const lista = filtradas();
      const totalPaginas = Math.max(1, Math.ceil(lista.length / POR_PAGINA));
      pagina = Math.min(Math.max(1, pagina), totalPaginas);

      lista.forEach((t, i) => {
        t.hidden = !(i >= (pagina - 1) * POR_PAGINA && i < pagina * POR_PAGINA);
      });
      sinResultados.hidden = lista.length > 0;

      paginador.innerHTML = "";
      if (totalPaginas <= 1) return;
      const crear = (texto, destino, { deshabilitado = false, activo = false, etiqueta = "" } = {}) => {
        const b = document.createElement("button");
        b.type = "button";
        b.innerHTML = texto;
        if (etiqueta) b.setAttribute("aria-label", etiqueta);
        b.disabled = deshabilitado;
        b.classList.toggle("activo", activo);
        b.addEventListener("click", () => { pagina = destino; render(); });
        paginador.append(b);
      };
      crear("&larr;", pagina - 1, { deshabilitado: pagina === 1, etiqueta: "Página anterior" });
      for (let p = 1; p <= totalPaginas; p++) crear(String(p), p, { activo: p === pagina, etiqueta: `Ir a la página ${p}` });
      crear("&rarr;", pagina + 1, { deshabilitado: pagina === totalPaginas, etiqueta: "Página siguiente" });
    };

    botones.forEach((btn) => {
      btn.addEventListener("click", () => {
        botones.forEach((b) => {
          b.classList.remove("btn-primary");
          b.classList.add("btn-ghost");
        });
        btn.classList.remove("btn-ghost");
        btn.classList.add("btn-primary");
        categoria = btn.dataset.filtro;
        pagina = 1;
        render();
      });
    });

    render();
  })();
</script>