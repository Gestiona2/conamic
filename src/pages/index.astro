---
/**
 * Página de inicio.
 *
 * REGLA: aquí NO se escribe texto. Todo sale de src/datos/inicio.json.
 * Si hay que cambiar una palabra, se cambia en el JSON — nunca aquí.
 */
import Layout from "../layouts/Layout.astro";
import datos from "../datos/inicio.json";
import articulosBlog from "../datos/actualidad.json";
import { ruta } from "../lib/ruta";

const { meta, portada, intro, servicios, cifras, identidad, radar, faq, ctaFinal } = datos;
/* Los 3 artículos más nuevos del blog para el bloque Actualidad del home. */
const ultimosArticulos = [...articulosBlog.articulos]
  .sort((a, b) => b.fechaISO.localeCompare(a.fechaISO))
  .slice(0, 3);
---

<Layout titulo={meta.titulo} descripcion={meta.descripcion} activa="inicio">
  {/* ==================== PORTADA ==================== */}
  <header class="portada">
    <div class="container portada-grid">
      <div>
        <span class="eyebrow reveal"><span class="dot"></span> {portada.encabezado}</span>
        <h1 class="reveal">
          {portada.titulo}<br />
          <span class="marca-text">{portada.tituloAcento}</span>
        </h1>
        <p class="lead reveal">{portada.texto}</p>
        <div class="portada-botones reveal">
          {portada.botones.map((b) => (
            <a href={ruta(b.href)} class={`btn ${b.estilo}`}>{b.texto}</a>
          ))}
        </div>
      </div>
      <div class="portada-visual reveal" data-parallax="0.08">
        <img src={ruta(portada.imagen)} alt={portada.imagenAlt} loading="eager" width="1200" height="900" />
      </div>
    </div>
  </header>

  {/* ==================== INTRO ==================== */}
  <section class="pad" id="porque">
    <div class="container nosotros-grid">
      <img class="reveal-left" src={ruta(intro.imagen)} alt={intro.imagenAlt} loading="eager" width="1200" height="800" />
      <div class="reveal-right">
        <span class="eyebrow"><span class="dot"></span> {intro.encabezado}</span>
        <h2 class="section-title">{intro.titulo}</h2>
        <p class="lead" style="margin: 18px 0;">{intro.texto1}</p>
        <p style="color: var(--text-muted); font-size: .97rem;">{intro.texto2}</p>
      </div>
    </div>
  </section>

  {/* ==================== BLINDAJE EMPRESARIAL ==================== */}
  <section class="pad" id="blindaje" style="background:var(--bg-soft)">
    <div class="container">
      <span class="eyebrow reveal"><span class="dot"></span> {servicios.encabezado}</span>
      <h2 class="section-title reveal">{servicios.titulo}</h2>
      <p class="lead reveal">{servicios.texto}</p>

      <div class="grid-servicios" data-stagger>
        {servicios.items.map((s) => (
          <article class="card reveal-up">
            <i data-lucide={s.icono}></i>
            <h3>{s.titulo}</h3>
            <p>{s.texto}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {/* ==================== CIFRAS ==================== */}
  <section class="pad cifras">
    <div class="container grid-cifras" data-stagger>
      {cifras.items.map((c) => (
        <div class="reveal-pop">
          <i data-lucide={c.icono}></i>
          <div class="cifra-num" data-contar={c.numero} data-sufijo={c.sufijo}>0</div>
          <p>{c.texto}</p>
        </div>
      ))}
    </div>
  </section>

  {/* ==================== IDENTIDAD (testimonios) ==================== */}
  <section class="pad">
    <div class="container">
      <span class="eyebrow reveal"><span class="dot"></span> {identidad.encabezado}</span>
      <h2 class="section-title reveal">{identidad.titulo}</h2>

      <div class="grid-testimonios" data-stagger>
        {identidad.items.map((t) => (
          <figure class="card articulo-card reveal-up">
            <img src={ruta(t.imagen)} alt={t.imagenAlt} loading="lazy" width="600" height="400" />
            <div class="articulo-cuerpo">
              <span class="articulo-etiqueta">{t.etiqueta}</span>
              <blockquote>"{t.texto}"</blockquote>
            </div>
          </figure>
        ))}
      </div>
    </div>
  </section>

  {/* ==================== RADAR GREMIAL — franja azul institucional ==================== */}
  <section class="pad franja-azul">
    <div class="container">
      <span class="eyebrow reveal"><span class="dot"></span> {radar.encabezado}</span>
      <h2 class="section-title reveal">{radar.titulo}</h2>
      <p class="lead reveal">{radar.texto}</p>

      <div class="grid-servicios" data-stagger>
        {ultimosArticulos.map((a) => (
          <article class="glass reveal-up" style="padding: 0; overflow:hidden; display:flex; flex-direction:column; border-radius:18px;">
            {!a.imagen.includes("provisional") && (
              <img src={ruta(a.imagen)} alt={a.imagenAlt} loading="eager" width="800" height="450" style="width:100%; aspect-ratio:16/9; object-fit:cover; display:block;" />
            )}
            <div style="padding:26px 28px 28px; display:flex; flex-direction:column; flex:1;">
              <span class="tl-anio" style="font-size:.78rem;">{a.categoria}</span>
              <h3 style="margin:14px 0 10px; font-size:1.08rem;"><a href={ruta(`/actualidad/${a.slug}`)} style="color:#fff;">{a.titulo}</a></h3>
              <p style="color:rgba(255,255,255,.75);font-size:.93rem;flex:1;">{a.descripcion}</p>
              <p style="color:rgba(255,255,255,.5);font-size:.8rem;margin-top:12px;">{a.fecha} · {a.tiempoLectura} de lectura</p>
              <a href={ruta(`/actualidad/${a.slug}`)} style="color:#f0c56a;font-weight:600;font-size:.88rem;display:inline-flex;align-items:center;gap:6px;margin-top:14px;">
                Leer artículo <i data-lucide="arrow-right" style="width:14px;height:14px;"></i>
              </a>
            </div>
          </article>
        ))}
      </div>

      <div class="reveal" style="margin-top:44px;">
        <a href={ruta("/actualidad")} class="btn btn-light">Ver más actualidad</a>
      </div>
    </div>
  </section>

  {/* ==================== PREGUNTAS FRECUENTES ==================== */}
  <section class="pad" id="faq">
    <div class="container">
      <span class="eyebrow reveal"><span class="dot"></span> {faq.encabezado}</span>
      <h2 class="section-title reveal">{faq.titulo}</h2>

      <div class="lista-faq" data-stagger>
        {faq.items.map((f) => (
          <details class="card reveal-up">
            <summary>{f.pregunta}</summary>
            <p>{f.respuesta}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {/* ==================== CTA FINAL ==================== */}
  <section class="pad" style="background:var(--bg-soft);">
    <div class="container" style="text-align:center; max-width:760px;">
      <h2 class="section-title reveal">{ctaFinal.titulo}</h2>
      <p class="lead reveal" style="margin-top:18px;">{ctaFinal.texto}</p>
      <div class="reveal" style="margin-top:36px;">
        <a href={ruta(ctaFinal.botonHref)} class="btn btn-primary" style="font-size:1.05rem; padding:17px 38px;">{ctaFinal.botonTexto}</a>
      </div>
    </div>
  </section>
</Layout>

<script is:inline>
  /* Contadores: animan de 0 al número final cuando entran en pantalla. */
  (function () {
    const menosMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const nums = Array.from(document.querySelectorAll("[data-contar]"));
    if (!nums.length) return;

    const pintar = (el) => {
      const destino = parseFloat(el.dataset.contar.replace(",", ".")) || 0;
      const sufijo = el.dataset.sufijo || "";
      const esDecimal = !Number.isInteger(destino);
      if (menosMovimiento) { el.textContent = destino + sufijo; return; }
      const inicio = performance.now();
      const paso = (ahora) => {
        const t = Math.min((ahora - inicio) / 1400, 1);
        const valor = destino * (1 - Math.pow(1 - t, 3));
        el.textContent = (esDecimal ? valor.toFixed(1) : Math.round(valor)) + sufijo;
        if (t < 1) requestAnimationFrame(paso);
      };
      requestAnimationFrame(paso);
    };

    if (!("IntersectionObserver" in window)) { nums.forEach(pintar); return; }
    const io = new IntersectionObserver((es) => {
      es.forEach((e) => { if (e.isIntersecting) { pintar(e.target); io.unobserve(e.target); } });
    }, { threshold: 0.5 });
    nums.forEach((n) => io.observe(n));
  })();
</script>