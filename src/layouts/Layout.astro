---
/**
 * Layout base — lo que se repite en todas las páginas.
 * Menú, pie, botón de tema, aparición al bajar, volver arriba.
 *
 * El contenido de cada página NO se escribe aquí: vive en src/datos/.
 */
import "../styles/global.css";
import sitio from "../datos/sitio.json";

interface Props {
  titulo: string;
  descripcion?: string;
  activa?: string;
}
const { titulo, descripcion = sitio.descripcion, activa = "" } = Astro.props;
const anio = new Date().getFullYear();
const urlMapa = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(sitio.direccion)}`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" href="/brand/favicon.png" />

    <!-- Redes sociales -->
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="/brand/logo.png" />

    <!--
      Evita el parpadeo de tema incorrecto.
      Va ANTES de que se pinte nada: si se mueve más abajo, el visitante
      ve un destello blanco al entrar con tema oscuro.
    -->
    <script is:inline define:vars={{ clave: sitio.claveTema }}>
      (function () {
        try {
          document.documentElement.setAttribute(
            "data-theme",
            localStorage.getItem(clave) || "light"
          );
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
  </head>

  <body>
    <!-- ==================== MENÚ ==================== -->
    <header class="nav" id="nav">
      <div class="container nav-inner">
        <a href="/" class="nav-logo">
          <img src="/brand/logo.png" alt={sitio.nombre} />
        </a>

        <nav class="nav-links" id="navLinks" aria-label="Navegación principal">
          {sitio.menu.map((item) => (
            <a href={item.href} class={activa === item.id ? "activo" : ""}>{item.texto}</a>
          ))}
        </nav>

        <div class="nav-actions">
          <button id="botonTema" aria-label="Cambiar entre tema claro y oscuro"></button>
          <a href={sitio.ctaPrincipal.href} class="btn btn-primary">{sitio.ctaPrincipal.texto}</a>
          <button id="botonMenu" aria-label="Abrir menú" aria-expanded="false">
            <svg class="icon-menu" xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
            <svg class="icon-close" xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display:none"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
          </button>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <!-- ==================== PIE — manual §27: logo en encabezado y footer ==================== -->
    <footer class="pie">
      <div class="container">
        <div class="pie-grid">
          <div>
            <div class="pie-logo">
              <img src="/brand/logo.png" alt={sitio.nombre} loading="lazy" />
            </div>
            <p class="pie-tagline">La fuerza que nace desde la base.</p>
            <p class="pie-desc">
              CONAMIC: la voz de los que hacen, siembran y construyen. Unidos somos la fuerza que mueve a Colombia.
            </p>
            <div class="pie-redes">
              {sitio.redes.map((r) => (
                r.href && <a href={r.href} target="_blank" rel="noopener" aria-label={r.nombre}><i data-lucide="globe"></i></a>
              ))}
            </div>
          </div>

          <div>
            <h5>Nuestra Lucha</h5>
            <ul>
              {sitio.menu.slice(0, 4).map((item) => (
                <li><a href={item.href}>{item.texto}</a></li>
              ))}
            </ul>
          </div>

          <div>
            <h5>Únete</h5>
            <ul>
              <li><a href="/afiliacion">Afíliate</a></li>
              <li><a href="/actualidad">Centro de Fortalecimiento</a></li>
              <li><a href="/contacto">Contáctanos</a></li>
            </ul>
          </div>

          <div>
            <h5>Contáctenos</h5>
            <ul class="pie-contacto">
              <li><i data-lucide="map-pin"></i><a href={urlMapa} target="_blank" rel="noopener">{sitio.direccion}</a></li>
              <li><i data-lucide="phone"></i><a href={`tel:+${sitio.whatsapp}`}>{sitio.telefono}</a></li>
              <li><i data-lucide="mail"></i><a href={`mailto:${sitio.correo}`}>{sitio.correo}</a></li>
              <li><i data-lucide="clock"></i><span>{sitio.horario}</span></li>
            </ul>
          </div>
        </div>

        <div class="pie-abajo">
          <p>&copy; {anio} {sitio.razonSocial} · NIT {sitio.nit}. Todos los derechos reservados.</p>
          <nav class="pie-legales">
            {sitio.legales.map((l) => <a href={l.href}>{l.texto}</a>)}
          </nav>
        </div>
      </div>
    </footer>

    <!-- El objetivo del sitio es el formulario; WhatsApp queda como canal alterno -->
    <a
      href={`https://wa.me/${sitio.whatsapp}?text=${encodeURIComponent(sitio.whatsappMensaje)}`}
      class="flota-wa"
      target="_blank"
      rel="noopener"
      aria-label="Escribir por WhatsApp"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
    </a>
    <button class="volver-arriba" id="volverArriba" aria-label="Volver arriba">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
    </button>

    <!--
      Librerías guardadas dentro del sitio, no desde servidores ajenos.
      Privacidad + longevidad. Ver conocimiento/politicas.md.
    -->
    <script is:inline src="/vendor/lucide/lucide.min.js"></script>
    <script is:inline src="/vendor/gsap/gsap.min.js"></script>
    <script is:inline src="/vendor/gsap/ScrollTrigger.min.js"></script>

    <script is:inline define:vars={{ clave: sitio.claveTema }}>
      const $ = (s) => document.querySelector(s);
      const $$ = (s) => Array.from(document.querySelectorAll(s));
      const raiz = document.documentElement;
      const menosMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (window.lucide) lucide.createIcons();

      /* ---------- Tema claro / oscuro ---------- */
      const botonTema = $("#botonTema");
      const pintarBotonTema = () => {
        botonTema.innerHTML =
          raiz.getAttribute("data-theme") === "dark"
            ? '<svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>'
            : '<svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>';
      };
      botonTema?.addEventListener("click", () => {
        const siguiente = raiz.getAttribute("data-theme") === "dark" ? "light" : "dark";
        raiz.setAttribute("data-theme", siguiente);
        try { localStorage.setItem(clave, siguiente); } catch (e) {}
        pintarBotonTema();
      });
      pintarBotonTema();

      /* ---------- Menú en celular ---------- */
      const botonMenu = $("#botonMenu");
      botonMenu?.addEventListener("click", () => {
        const abierto = $("#navLinks").classList.toggle("abierto");
        botonMenu.setAttribute("aria-expanded", String(abierto));
        const iconMenu = botonMenu.querySelector(".icon-menu");
        const iconClose = botonMenu.querySelector(".icon-close");
        if (iconMenu && iconClose) {
          iconMenu.style.display = abierto ? "none" : "block";
          iconClose.style.display = abierto ? "block" : "none";
        }
      });

      /* ---------- Apariciones al bajar, con GSAP ---------- */
      if (window.gsap && window.ScrollTrigger && !menosMovimiento) {
        gsap.registerPlugin(ScrollTrigger);
        $$(".reveal").forEach((el) =>
          gsap.to(el, {
            opacity: 1, y: 0, duration: 0.9, ease: "power3.out",
            scrollTrigger: { trigger: el, start: "top 88%" },
          })
        );
        // Parallax suave: data-parallax="0.08" (valores altos marean)
        $$("[data-parallax]").forEach((el) => {
          gsap.to(el, {
            yPercent: -parseFloat(el.dataset.parallax) * 100, ease: "none",
            scrollTrigger: { trigger: el, start: "top bottom", end: "bottom top", scrub: true },
          });
        });
      } else {
        // Sin GSAP o con movimiento reducido: mostrar todo de una vez.
        $$(".reveal").forEach((el) => { el.style.opacity = 1; el.style.transform = "none"; });
      }

      /* ---------- Apariciones en CSS puro ---------- */
      const apariciones = $$(".reveal-up, .reveal-left, .reveal-right, .reveal-pop");
      // Retraso escalonado dentro de un grupo con data-stagger
      $$("[data-stagger]").forEach((grupo) => {
        Array.from(grupo.children).forEach((hijo, i) => hijo.style.setProperty("--i", i));
      });

      if (menosMovimiento || !("IntersectionObserver" in window)) {
        apariciones.forEach((el) => el.classList.add("seen"));
      } else {
        const observador = new IntersectionObserver(
          (entradas) => {
            entradas.forEach((entrada) => {
              if (entrada.isIntersecting) {
                entrada.target.classList.add("seen");
                observador.unobserve(entrada.target);
              }
            });
          },
          { threshold: 0.18, rootMargin: "0px 0px -8% 0px" }
        );
        apariciones.forEach((el) => observador.observe(el));
      }

      /* ---------- Menú con fondo al bajar + volver arriba ---------- */
      const nav = $("#nav");
      const volverArriba = $("#volverArriba");
      const alBajar = () => {
        nav.classList.toggle("bajado", window.scrollY > 20);
        volverArriba.classList.toggle("visible", window.scrollY > 600);
      };
      window.addEventListener("scroll", alBajar, { passive: true });
      alBajar();
      volverArriba?.addEventListener("click", () =>
        window.scrollTo({ top: 0, behavior: menosMovimiento ? "auto" : "smooth" })
      );
    </script>
  </body>
</html>